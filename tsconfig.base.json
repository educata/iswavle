{
  "compileOnSave": false,
  "compilerOptions": {
    "outDir": "./dist/out-tsc",
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "noImplicitOverride": true,
    "noPropertyAccessFromIndexSignature": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "esModuleInterop": true,
    "sourceMap": true,
    "declaration": false,
    "experimentalDecorators": true,
    "moduleResolution": "bundler",
    "importHelpers": true,
    "target": "ES2022",
    "module": "ES2022",
    "useDefineForClassFields": false,
    "lib": ["ES2022", "dom"],
    "paths": {
      "@app-shared/*": ["./apps/iswavle/src/app/shared/*"],
      "@global-shared/*": ["./shared/*"],
      "@iswavle/features/docs": ["libs/features/docs/src/index.ts"],
      "@iswavle/features/exercises": ["libs/features/exercises/src/index.ts"],
      "@iswavle/features/home": ["libs/features/home/src/index.ts"],
      "@iswavle/features/not-found": ["libs/features/not-found/src/index.ts"],
      "@iswavle/features/playground": ["libs/features/playground/src/index.ts"],
      "@iswavle/shared/data-access": ["libs/shared/data-access/src/index.ts"],
      "@iswavle/shared/ui": ["libs/shared/ui/src/index.ts"],
      "@iswavle/shared/utils": ["libs/shared/utils/src/index.ts"]
    },
    "typeRoots": ["./node_modules/@types", "./src/types"],
    "baseUrl": ".",
    "rootDir": "."
  },
  "angularCompilerOptions": {
    "enableI18nLegacyMessageIdFormat": false,
    "strictInjectionParameters": true,
    "strictInputAccessModifiers": true,
    "strictTemplates": true
  },
  "exclude": ["node_modules", "tmp"]
}
