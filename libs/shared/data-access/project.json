{
  "name": "shared-data-access",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/shared/data-access/src",
  "prefix": "sw",
  "projectType": "library",
  "tags": ["type:data-access", "scope:shared"],
  "targets": {
    "test": {
      "executor": "@nx/jest:jest",
      "outputs": ["{workspaceRoot}/coverage/{projectRoot}"],
      "options": {
        "jestConfig": "libs/shared/data-access/jest.config.ts",
        "tsConfig": "libs/shared/data-access/tsconfig.spec.json"
      }
    },
    "configurations": {
      "development": {
        "fileReplacements": [
          {
            "replace": "libs/shared/data-access/src/lib/environments/environment.ts",
            "with": "libs/shared/data-access/src/lib/environments/environment.development.ts"
          }
        ]
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint"
    }
  }
}
